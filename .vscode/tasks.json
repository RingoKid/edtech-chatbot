// .vscode/tasks.json
{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "docker-compose-up (debug)",
            "type": "docker-compose",
            "dockerCompose": {
                "up": {
                    "build": true,
                    "detached": true
                },
                "files": [
                    "${workspaceFolder}/docker-compose.yml",
                    "${workspaceFolder}/docker-compose.override.yml"
                ]
            },
            "problemMatcher": [],
            "group": "build"
        },
        {
            "label": "Start Debug Containers (Shell)",
            "type": "shell",
            "command": "docker-compose",
            "args": [
                "-f", "docker-compose.yml",
                "-f", "docker-compose.override.yml",
                "up", "--build", "-d"
            ],
            "group": "build",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared",
                "showReuseMessage": true
            },
            "problemMatcher": []
        }
    ]
}