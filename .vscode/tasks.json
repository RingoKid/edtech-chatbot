        {
            "label": "DevContainer: Start Backend Services",
            "type": "shell",
            "command": "cd /workspace/backend && langgraph dev --host 0.0.0.0 --port 2024 & uvicorn app.main:app --host 0.0.0.0 --port 8000 --reload",
            "isBackground": true,
            "problemMatcher": [],
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "dedicated",
                "showReuseMessage": false
            },
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "label": "DevContainer: Start FastAPI Only",
            "type": "shell",
            "command": "cd /workspace/backend && uvicorn app.main:app --host 0.0.0.0 --port 8000 --reload",
            "isBackground": true,
            "problemMatcher": [],
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "dedicated",
                "showReuseMessage": false
            }
        },
        {
            "label": "DevContainer: Start LangGraph Studio Only",
            "type": "shell",
            "command": "cd /workspace/backend && langgraph dev --host 0.0.0.0 --port 2024",
            "isBackground": true,
            "problemMatcher": [],
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "dedicated",
                "showReuseMessage": false
            }
        }
    ]
