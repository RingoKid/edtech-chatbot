{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Backend: Attach to Docker",
            "type": "debugpy",
            "request": "attach",
            "preLaunchTask": "docker-compose-up (debug)",
            "connect": {
                "host": "localhost",
                "port": 5678
            },
            "pathMappings": [
                {
                    "localRoot": "${workspaceFolder}/backend",
                    "remoteRoot": "/app"
                }
            ],
            "justMyCode": false,
            "redirectOutput": true,
            "showReturnValue": true
        },
        {
            "name": "Backend: Attach Manual (No PreLaunch)",
            "type": "debugpy",
            "request": "attach",
            "connect": {
                "host": "localhost",
                "port": 5678
            },
            "pathMappings": [
                {
                    "localRoot": "${workspaceFolder}/backend",
                    "remoteRoot": "/app"
                }
            ],
            "justMyCode": false,
            "redirectOutput": true,
            "showReturnValue": true
        },
        {
            "name": "Dev Container: Python Debug Current File",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal",
            "cwd": "/workspace/backend",
            "env": {
                "PYTHONPATH": "/workspace/backend"
            },
            "justMyCode": false,
            "args": []
        },
        {
            "name": "Dev Container: FastAPI Debug",
            "type": "debugpy",
            "request": "launch",
            "module": "uvicorn",
            "args": [
                "app.main:app",
                "--host",
                "0.0.0.0", 
                "--port",
                "8000",
                "--reload"
            ],
            "cwd": "/workspace/backend",
            "env": {
                "PYTHONPATH": "/workspace/backend"
            },
            "console": "integratedTerminal",
            "justMyCode": false
        },
        {
            "name": "Frontend: Launch Chrome against localhost",
            "type": "chrome",
            "request": "launch",
            "url": "http://localhost:3000",
            "webRoot": "${workspaceFolder}/frontend/src",
            "sourceMaps": true
        }
    ],
    "compounds": [
        {
            "name": "Full-Stack Debug (Docker)",
            "configurations": [
                "Backend: Attach to Docker",
                "Frontend: Launch Chrome against localhost"
            ]
        }
    ]
}