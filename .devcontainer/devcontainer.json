{
  "name": "EdTech Chatbot - Full Stack",
  "dockerComposeFile": [
    "../docker-compose.yml",
    "docker-compose.devcontainer.yml"
  ],
  "service": "backend",
  "runServices": ["backend", "frontend", "dynamodb-local"],
  "workspaceFolder": "/workspace",
  "overrideCommand": true,
  "customizations": {
    "vscode": {
      "settings": {
        "python.defaultInterpreterPath": "/usr/local/bin/python",
        "python.linting.enabled": true,
        "python.linting.pylintEnabled": false,
        "python.formatting.provider": "none",
        "python.analysis.autoSearchPaths": true,
        "python.analysis.extraPaths": [
          "/workspace/backend"
        ],
        "python.analysis.typeCheckingMode": "off",
        "python.analysis.diagnosticSeverityOverrides": {
          "reportAttributeAccessIssue": "none",
          "reportGeneralTypeIssues": "none",
          "reportArgumentType": "none",
          "reportReturnType": "none",
          "reportIndexIssue": "none",
          "reportOptionalMemberAccess": "none",
          "reportCallIssue": "none",
          "reportOperatorIssue": "none",
          "reportOptionalCall": "none",
          "reportMissingImports": "none",
          "reportMissingModuleSource": "none"
        },
        "python.analysis.indexing": true,
        "python.testing.pytestEnabled": true,
        "python.testing.pytestArgs": [
          "backend/tests"
        ],
        "editor.formatOnSave": true,
        "editor.codeActionsOnSave": {
          "source.organizeImports": "explicit"
        },
        "files.watcherExclude": {
          "**/node_modules/**": true,
          "**/.venv/**": true,
          "**/venv/**": true,
          "**/__pycache__/**": true,
          "**/.pytest_cache/**": true
        },
        "eslint.workingDirectories": [
          "./frontend"
        ],
        "[javascript]": {
          "editor.defaultFormatter": "esbenp.prettier-vscode"
        },
        "[javascriptreact]": {
          "editor.defaultFormatter": "esbenp.prettier-vscode"
        },
        "[typescript]": {
          "editor.defaultFormatter": "esbenp.prettier-vscode"
        },
        "[typescriptreact]": {
          "editor.defaultFormatter": "esbenp.prettier-vscode"
        },
        "[json]": {
          "editor.defaultFormatter": "esbenp.prettier-vscode"
        }
      },
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "ms-python.debugpy",
        "ms-azuretools.vscode-docker",
        "esbenp.prettier-vscode",
        "dbaeumer.vscode-eslint",
        "bradlc.vscode-tailwindcss",
        "dsznajder.es7-react-js-snippets",
        "humao.rest-client",
        "anthropic.claude-code"
      ]
    }
  },
  "features": {
    "ghcr.io/devcontainers/features/git:1": {},
    "ghcr.io/devcontainers/features/sshd:1": {
      "version": "latest"
    }
  },
  "mounts": [
    "source=${localEnv:HOME}${localEnv:USERPROFILE}/.claude,target=/root/.claude,type=bind,consistency=cached",
    "source=${localEnv:HOME}${localEnv:USERPROFILE}/.config/claude,target=/root/.config/claude,type=bind,consistency=cached",
    "source=${localEnv:HOME}${localEnv:USERPROFILE}/.ssh,target=/root/.ssh-localhost,type=bind,consistency=cached,readonly"
  ],
  "forwardPorts": [3000, 8000, 2024, 8001],
  "portsAttributes": {
    "3000": {
      "label": "Frontend",
      "onAutoForward": "notify"
    },
    "8000": {
      "label": "Backend API",
      "onAutoForward": "notify"
    },
    "2024": {
      "label": "LangGraph Studio",
      "onAutoForward": "notify"
    },
    "8001": {
      "label": "DynamoDB Local",
      "onAutoForward": "silent"
    }
  },
  "postCreateCommand": "apt-get update && apt-get install -y curl openssh-client && pip install -r /workspace/backend/requirements.txt && curl -fsSL https://claude.ai/install.sh | bash && echo 'export PATH=\"$HOME/.local/bin:$PATH\"' >> /root/.bashrc && mkdir -p /root/.ssh && cp /root/.ssh-localhost/* /root/.ssh/ 2>/dev/null || true && chmod 700 /root/.ssh && chmod 600 /root/.ssh/id_* 2>/dev/null || true && chmod 644 /root/.ssh/*.pub 2>/dev/null || true",
  "remoteUser": "root",
  "remoteEnv": {
    "PATH": "/root/.local/bin:${containerEnv:PATH}",
    "SSH_AUTH_SOCK": "${localEnv:SSH_AUTH_SOCK}"
  }
}
